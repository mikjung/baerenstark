// Bärenstark Hausservice — Prisma Schema (MVP, v1.3 — Iteration 3)
// Single source of truth für das Datenmodell.
// Live-Schema unter prisma/schema.prisma muss mit dieser Datei synchron bleiben.
//
// Änderungen v1.3 (Iteration 3 — US-17 bis US-24):
//   - **NEU**: AvailabilityTemplate (US-17) — globale Wochentag-Standardzeiten.
//   - **NEU**: DayOverride (US-17) — individuelle Tages-Überschreibung.
//   - **NEU**: BookingAttachment (US-18) — Datei-Anhänge an Buchungen.
//   - Booking erhält neue Felder date/startTime/endTime (US-17): konkrete
//     gewählte Uhrzeit innerhalb des Verfügbarkeitsfensters. slotId wird
//     optional (Rückwärtskompatibilität für Bestandsbuchungen).
//   - WeeklyAvailability bleibt erhalten (Bestandsdaten / Migration), wird
//     aber für neue Buchungen NICHT mehr genutzt — AvailabilityTemplate ist
//     ihre Erweiterung mit Zeit-Komponenten.
//   - Slot wird DEPRECATED (siehe Doku unten). Keine Schema-Änderung am
//     Slot-Modell selbst — nur die Anwendung ändert sich.
//   - Service-Slug 'sonstiges' wird in der App-Konstante ergänzt (kein
//     Schema-Eintrag, weil Service als String persistiert wird).
//
// Änderungen v1.2 (Iteration 2 — US-13 bis US-16, BUG US-04):
//   - Booking.cancelToken (String, unique, @default(cuid()))
//   - Booking.counterProposalSlotId (String?)
//   - BookingStatus erweitert um COUNTER_PROPOSED und CANCELLED.
//   - Neues Modell WeeklyAvailability (US-15).
//
// Änderungen v1.1 (gegenüber v1.0):
//   - Partial Unique Index, Soft-Delete für Slot, Mail-Reliability-Felder.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // SQLite via Turso (libSQL-Adapter) in Produktion.
  // Lokal: Datei-basiert via "file:./dev.db" in .env.local.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Admin-Benutzer. Im MVP genau ein Datensatz (Tom).
/// Wird via Setup-Wizard /admin/setup angelegt.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  @@map("users")
}

/// **DEPRECATED ab Iteration 3 (US-17).** Bestehende Buchungen behalten
/// ihre Slot-Referenz für Rückwärtskompatibilität; neue Buchungen nutzen
/// `Booking.date / startTime / endTime` direkt.
///
/// Das Modell bleibt im Schema, weil es:
///   - Iteration-1- und Iteration-2-Bestandsdaten hostet,
///   - der Counter-Proposal-Flow (US-13) noch über Slot-IDs läuft (Bestand),
///   - die Soft-Delete-Logik weiterhin funktioniert.
///
/// Neue Engineering-Hinweise für IT3:
///   - `POST /api/slots` und `DELETE /api/slots/:id` bleiben erhalten,
///     werden aber im Admin-UI versteckt (kein neuer Slot anlegen).
///   - `GET /api/slots` darf weiterhin abgerufen werden (öffentlich), liefert
///     nur Bestandsslots — neue Buchungs-UI nutzt `GET /api/slots/available`
///     (Iteration 3) statt `GET /api/slots`.
///
/// Siehe ARCHITECTURE.md §16 für die Migration-Strategie.
model Slot {
  id          String    @id @default(cuid())
  startsAt    DateTime
  endsAt      DateTime
  description String?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  bookings              Booking[] @relation("BookingPrimarySlot")
  proposedForBookings   Booking[] @relation("BookingCounterProposalSlot")

  @@index([startsAt])
  @@index([startsAt, endsAt])
  @@index([deletedAt])
  @@map("slots")
}

/// Buchungsanfrage eines Kunden.
///
/// **Iteration-3-Datenmodell (US-17):**
///   Neue Buchungen haben `slotId = null` und stattdessen
///   `date + startTime + endTime` direkt befüllt. Das ermöglicht den
///   Verfügbarkeitsfenster-Flow ohne pre-allokierte Slot-Datensätze.
///
///   Bestehende Buchungen (Iteration 1/2) haben `slotId` befüllt und
///   `date/startTime/endTime` leer.
///
/// **Datums-/Zeit-Konvention (Iteration 3, Berlin-TZ-First):**
///   - `date`:      "YYYY-MM-DD"  (Berlin-Lokalzeit, kein Offset)
///   - `startTime`: "HH:MM"       (24h, Berlin)
///   - `endTime`:   "HH:MM"       (24h, Berlin, > startTime)
///   Begründung: Tom denkt in Berlin-Zeit. Kein Timezone-Shift bei
///   Sommer/Winterzeit-Übergang (vermeidet "08:00 wird zu 07:00 nach
///   DST"-Bug). Backend rendert in Mails via `Intl.DateTimeFormat`
///   mit explizitem Berlin-TZ.
///
/// Status-Lebenszyklus (unverändert seit Iteration 2):
///   PENDING            → CONFIRMED         (Admin bestätigt)
///   PENDING            → REJECTED          (Admin lehnt ab)
///   PENDING            → COUNTER_PROPOSED  (Admin schlägt Alternativtermin vor)
///   PENDING            → CANCELLED         (Kunde storniert per Token-Link)
///   CONFIRMED          → REJECTED          (Admin zieht Bestätigung zurück)
///   COUNTER_PROPOSED   → CONFIRMED         (Kunde nimmt Vorschlag per Token-Link an)
///   COUNTER_PROPOSED   → PENDING           (Kunde wählt neuen Slot via Re-Booking-Flow)
///   COUNTER_PROPOSED   → CANCELLED         (Kunde storniert per Token-Link)
///
/// **Verfügbarkeits-Belegung (Iteration 3):**
///   Pro (date, startTime, endTime) darf höchstens EINE aktive Buchung
///   (Status ∈ {PENDING, CONFIRMED, COUNTER_PROPOSED}) existieren.
///   Garantie via Partial Unique Index (Raw-SQL-Migration):
///
///     CREATE UNIQUE INDEX uniq_active_booking_per_timeslot
///       ON bookings(date, start_time, end_time)
///       WHERE date IS NOT NULL
///         AND status IN ('PENDING','CONFIRMED','COUNTER_PROPOSED');
///
///   Bestandsindex `uniq_active_booking_per_slot` bleibt erhalten — er
///   greift nur, wenn `slot_id IS NOT NULL`. Beide Indexe existieren parallel
///   und decken die jeweiligen Buchungs-Modi ab.
model Booking {
  id            String        @id @default(cuid())

  // --- Iteration 1/2: Slot-basierte Buchung (DEPRECATED, nur Bestand) ---
  // Optional ab Iteration 3. Neue Buchungen lassen das Feld leer.
  slotId        String?
  slot          Slot?         @relation("BookingPrimarySlot", fields: [slotId], references: [id], onDelete: Restrict)

  // --- Iteration 3 (US-17): Date/Time-basierte Buchung ---
  /// "YYYY-MM-DD" im Berlin-TZ. Pflicht für neue Buchungen.
  date          String?
  /// "HH:MM" im Berlin-TZ. Pflicht für neue Buchungen.
  startTime     String?
  /// "HH:MM" im Berlin-TZ. Pflicht für neue Buchungen, > startTime.
  endTime       String?

  // --- Kundendaten (unverändert) ---
  customerName  String
  customerPhone String
  customerEmail String?
  service       String        // Slug aus SERVICES-Konstante (siehe lib/services.ts)
  description   String

  status        BookingStatus @default(PENDING)

  // --- Mail-Reliability (BUG-002, unverändert) ---
  mailSent      Boolean       @default(false)
  mailError     String?

  // --- Iteration 2 Felder (unverändert) ---
  cancelToken   String        @unique @default(cuid())
  counterProposalSlotId String?
  counterProposalSlot   Slot?  @relation("BookingCounterProposalSlot", fields: [counterProposalSlotId], references: [id], onDelete: SetNull)

  // --- Iteration 3 Felder ---
  /// 0..N hochgeladene Dateien (Fotos, Videos, PDFs) — Vercel Blob (US-18).
  attachments   BookingAttachment[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([slotId])
  @@index([status, createdAt])
  @@index([counterProposalSlotId])
  // Iteration 3 — Index für Verfügbarkeits-Lookup (GET /api/slots/available).
  @@index([date, status])
  // Iteration 3 — Index für Admin-Dashboard (US-21: bevorstehende Termine).
  @@index([status, date, startTime])
  // Hinweis: Partial Unique Indexe (`uniq_active_booking_per_slot` und
  // `uniq_active_booking_per_timeslot`) werden per Raw-SQL-Migration angelegt.
  @@map("bookings")
}

/// Default-Vorlage pro Wochentag (Iteration 3 / US-17).
///
/// Tom definiert für jeden Wochentag (0=So..6=Sa) ein Verfügbarkeitsfenster
/// (z.B. Mo–Fr 08:00–17:00). Genau **sieben** Datensätze (Initial-Seed).
///
/// Beziehung zu DayOverride: Wenn für ein konkretes Datum ein DayOverride
/// existiert, hat er Vorrang vor der Template. Sonst gilt die Template.
///
/// Beziehung zu WeeklyAvailability (Iteration 2):
/// AvailabilityTemplate.isActive ersetzt funktional WeeklyAvailability.isActive.
/// Migration kopiert beim Iteration-3-Deploy die `isActive`-Werte aus
/// WeeklyAvailability in AvailabilityTemplate. WeeklyAvailability bleibt für
/// Iteration-2-Bestandsbuchungen lesbar; neue Endpunkte nutzen
/// AvailabilityTemplate.
///
/// `slotDurationMinutes`: Tom kann pro Wochentag steuern, wie lang ein
/// Buchungs-Block ist (Default 60). Beispiel: Mo 08:00–17:00 mit 60-min-Slots
/// liefert Slots 08:00, 09:00, 10:00, ..., 16:00 (letzter Slot endet 17:00).
model AvailabilityTemplate {
  id                  String   @id @default(cuid())
  /// 0=Sonntag, 1=Montag, ..., 6=Samstag (analog Date.getDay()).
  dayOfWeek           Int      @unique
  /// false = Tag standardmäßig nicht verfügbar (rot im Kalender).
  isActive            Boolean  @default(false)
  /// "HH:MM" Beginn des Verfügbarkeitsfensters (Berlin-TZ).
  startTime           String   @default("08:00")
  /// "HH:MM" Ende des Verfügbarkeitsfensters (Berlin-TZ), > startTime.
  endTime             String   @default("17:00")
  /// Slot-Block-Länge in Minuten. Empfohlene Werte: 30, 60, 90, 120.
  slotDurationMinutes Int      @default(60)
  updatedAt           DateTime @updatedAt

  @@index([dayOfWeek])
  @@map("availability_template")
}

/// Individuelle Tages-Überschreibung (Iteration 3 / US-17).
///
/// Erlaubt Tom, einzelne Tage abweichend zur Default-Vorlage zu konfigurieren:
///   - `isActive: false` + `startTime/endTime: null` → Tag ist gesperrt
///     (z.B. Urlaub, Feiertag).
///   - `isActive: true` + `startTime/endTime: "09:00"/"15:00"` → Tag hat
///     abweichende Zeiten (kürzeres Fenster).
///   - `isActive: true` + `startTime/endTime: null` → Tag nutzt die Template-
///     Zeiten, aber explizit aktiviert (selten genutzt; primär für
///     "ausnahmsweise samstags geöffnet"-Szenarien).
///
/// Auflösungs-Logik im Backend (siehe lib/availability.ts):
///   1. DayOverride für `date`? Wenn ja → daraus
///      `(isActive, startTime ?? template.startTime, endTime ?? template.endTime)`
///      ableiten.
///   2. Sonst → AvailabilityTemplate für den Wochentag.
///
/// `date` ist UNIQUE: pro Datum existiert höchstens ein Override.
model DayOverride {
  id        String   @id @default(cuid())
  /// "YYYY-MM-DD" im Berlin-TZ.
  date      String   @unique
  isActive  Boolean
  /// "HH:MM" oder null (= Template-Default übernehmen).
  startTime String?
  /// "HH:MM" oder null.
  endTime   String?
  /// Optionale Notiz für Tom: "Urlaub", "Feiertag", "Familienevent".
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@map("day_overrides")
}

/// Datei-Anhang an einer Buchung (Iteration 3 / US-18).
///
/// Storage: Vercel Blob (kostenlos bis 2 GB). Frontend lädt Datei via
/// `POST /api/upload` hoch und erhält eine Public-URL zurück, die im
/// `BookingAttachment.url` persistiert wird.
///
/// Limits (im App-Layer durchgesetzt, nicht in der DB):
///   - max. 5 Dateien pro Buchung
///   - max. 20 MB pro Datei
///   - akzeptierte Content-Types: image/* | video/mp4 | application/pdf
///
/// Lifecycle:
///   - Cascade-Delete: wird die Buchung gelöscht, werden Attachments
///     mitgelöscht (DB-Eintrag). Die Blob-Datei selbst muss separat über
///     einen Cleanup-Job (Backlog) entfernt werden — Vercel Blob hat
///     keine FK-Cascade auf Storage-Ebene.
///   - Im MVP keine Soft-Delete; gelöscht ist gelöscht.
model BookingAttachment {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  /// Public-URL aus Vercel Blob (https://*.public.blob.vercel-storage.com/...).
  url         String
  /// Originaldateiname (sanitized — kein Pfad-Traversal).
  filename    String
  /// MIME-Type, wird vom Upload-Endpoint validiert.
  contentType String
  /// Größe in Bytes (für UI-Anzeige; redundant zur Blob-Storage-Info).
  sizeBytes   Int
  createdAt   DateTime @default(now())

  @@index([bookingId])
  @@map("booking_attachments")
}

/// Wochentag-basierte Verfügbarkeit (Iteration 2 / US-15).
///
/// **DEPRECATED ab Iteration 3** zugunsten von `AvailabilityTemplate`, das
/// zusätzlich Zeit-Komponenten und Slot-Dauer enthält.
///
/// Bleibt im Schema für:
///   - Bestand: alte Frontend-Pfade lesen evtl. noch GET /api/availability.
///   - Migration: Iteration-3-Deploy übernimmt die isActive-Flags 1:1
///     in AvailabilityTemplate (siehe `prisma/migrations/.../seed.sql`).
///
/// Neue Iteration-3-UI nutzt ausschließlich `/api/admin/availability-template`.
model WeeklyAvailability {
  id        String   @id @default(cuid())
  dayOfWeek Int      @unique
  isActive  Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@index([dayOfWeek])
  @@map("weekly_availability")
}

/// SQLite kennt kein natives ENUM — Prisma serialisiert es als TEXT.
///
/// Iteration 3: keine Erweiterung an BookingStatus.
enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  COUNTER_PROPOSED
  CANCELLED
}
