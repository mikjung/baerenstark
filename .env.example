# Database
# Lokal:    relativ zur prisma/schema.prisma → Datei landet in prisma/dev.db
# Turso:    libsql://<db-name>-<org>.turso.io?authToken=<token>
DATABASE_URL="file:./dev.db"
DIRECT_DATABASE_URL="file:./dev.db"

# NextAuth — Pflicht
# Lokal: http://localhost:3000
# Produktion (v1.5.1): https://www.baerenstark-hausservice.app
#                      (vorher: https://baerenstark.vercel.app — veraltet)
# Wird genutzt für: Reset-Mail-Links (US-30), OAuth-Callback-URLs (US-31),
# `safeCustomerCallback`-Open-Redirect-Schutz.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-32-plus-character-random-string"
# AUTH_SECRET ist Alias für NEXTAUTH_SECRET (NextAuth v5)
AUTH_SECRET="change-me-to-a-32-plus-character-random-string"
AUTH_TRUST_HOST="true"

# Resend / Mail — Pflicht
# Mit dem Placeholder `re_xxxxxxxxxxxx` schlägt der Mail-Versand stillschweigend
# fehl, Buchungen werden trotzdem persistiert (mailSent=false im Admin sichtbar).
# Echten Wert in resend.com → API Keys generieren.
RESEND_API_KEY="re_xxxxxxxxxxxx"
# Free-Tier-Hinweis: Ohne DNS-verifizierte Domain darf Resend nur an die
# Resend-Account-E-Mail senden. Für Iteration 2 (Mails an beliebige Kunden)
# wird eine verifizierte Absender-Domain Pflicht.
#
# IT10 / US-IT10-01 (Passwort-Reset-Mail-Bug):
#   Der kanonische Variablen-Name ist `MAIL_FROM` (NICHT `RESEND_FROM_EMAIL`).
#   In Vercel Production MUSS `MAIL_FROM` gesetzt sein und auf eine im Resend-
#   Dashboard DNS-verifizierte Absender-Domain zeigen, sonst stellt Resend die
#   Reset-Mail nicht zu (Endpoint antwortet wegen Email-Enumeration-Schutz
#   trotzdem 200).
MAIL_FROM="onboarding@resend.dev"
MAIL_TO_ADMIN="hausservice-baerenstark@outlook.com"

# Iteration 2: Public Base-URL für Aktionslinks in Mails (Counter-Proposal,
# Storno). Fallback ist NEXTAUTH_URL.
# Lokal: http://localhost:3000
# Produktion (v1.5.1): https://www.baerenstark-hausservice.app
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Upstash Redis (optional; ohne diese Werte ist Rate-Limit deaktiviert)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Iteration 3 / US-18 — Vercel Blob für Datei-Uploads.
# Token aus Vercel Dashboard → Storage → Blob → Connect to Project.
# Ohne diesen Token schlägt POST /api/upload mit 502 + klarer Fehlermeldung fehl
# (Buchungen ohne Anhänge funktionieren weiterhin).
BLOB_READ_WRITE_TOKEN=""

# Iteration 4 / US-28 — Stripe-Zahlungen.
# Test-Mode: sk_test_... + pk_test_... + whsec_... aus Stripe Dashboard.
# Live-Mode: sk_live_... + pk_live_... + whsec_... (frischer Webhook-Secret).
# Ohne Konfiguration meldet POST /api/admin/bookings/:id/payment den Code
# `STRIPE_NOT_CONFIGURED` zurück; das Backend bleibt bedienbar, aber Stripe-
# Checkout-Sessions können nicht erstellt werden.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Iteration 5 / US-31 — OAuth2-Customer-Login (Google + GitHub).
# Tom legt OAuth-Apps in den Provider-Konsolen an und liefert die
# Client-IDs/Secrets. Ohne diese Werte sind die OAuth-Buttons im
# Frontend deaktiviert (Feature-Flag); E-Mail/Passwort-Login bleibt
# weiterhin verfügbar.
#
# Authorized Redirect URIs (in den Provider-Konsolen einzutragen):
#   Dev:        http://localhost:3000/api/auth/customer/callback/google
#               http://localhost:3000/api/auth/customer/callback/github
#   Production: https://www.baerenstark-hausservice.app/api/auth/customer/callback/google
#               https://www.baerenstark-hausservice.app/api/auth/customer/callback/github
#               (v1.5.1: vorher baerenstark.vercel.app — veraltet)
#
# Hinweis (v1.5.1): Bei Domain-Wechsel müssen die Authorized Redirect
# URIs in beiden Provider-Konsolen aktualisiert werden, sonst schlägt
# der OAuth-Flow mit "redirect_uri_mismatch" fehl.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Iteration 5 / US-31 — GitHub-Provider entfernt mit IT6 (US-IT6-05).
# Variablen können in `.env` belassen bleiben — werden ignoriert.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Iteration 6 / US-IT6-05 — Facebook OAuth (ersetzt GitHub).
# Tom liefert Client-ID/Secret aus dem Meta Developer Portal.
# Authorized Redirect URI:
#   https://www.baerenstark-hausservice.app/api/auth/customer/callback/facebook
# Hinweis: Facebook erfordert eine verifizierte App-Domain für Live-Mode.
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Iteration 5 / US-31 — Feature-Flag für OAuth-Login.
# Wenn `false`, antwortet `/api/auth/customer/[...nextauth]` mit 503 und das
# Frontend blendet die OAuth-Buttons aus. Default (leer/unset) → automatisch
# `true`, sobald mindestens ein Provider-Paar (CLIENT_ID + SECRET) gesetzt ist.
FEATURE_OAUTH_LOGIN=""

# Iteration 6 / US-IT6-06 — User-Wipe-Skript-Gate.
# Pflicht für `npx tsx scripts/reset-users.ts`. Sonst lehnt das Skript ab.
ALLOW_USER_WIPE=""

# Iteration 6 / US-IT6-01 + F1 — Bootstrap-Allowlist für POST /api/admin/setup.
# MUSS vor dem Wipe-Run in Prod gesetzt sein, damit Tom sich als
# erster Admin anlegen kann. Ohne diesen Wert blockiert der Setup-
# Endpoint mit 503 SETUP_NOT_CONFIGURED. Bei Email-Mismatch → 403
# BOOTSTRAP_NOT_ALLOWED. Wird nur ausgewertet, solange `users` leer ist.
# Empfohlen: nach erfolgreichem Bootstrap aus dem Hosting-Env entfernen.
BOOTSTRAP_ADMIN_EMAIL=""

# Iteration 11 / US-IT11-03 + US-IT11-06 — Booking-Token-Secret.
# HMAC-SHA256-Secret für die signierten Bestätigungs-/Storno-Tokens
# (`signBookingConfirmationToken` / `signBookingCancellationToken`).
# Pflicht in Prod — Tokens werden in der Receipt-Mail eingebettet (30 Tage
# gültig). Niemals reusen mit AUTH_SECRET (separater Blast-Radius).
# Generieren: `openssl rand -base64 48`.
BOOKING_TOKEN_SECRET=""

# Iteration 12 / US-IT12-15 — Marketing-Mail-Unsubscribe-Token-Secret.
# HMAC-SHA256-Secret für stateless Unsubscribe-Tokens. NIEMALS reusen mit
# AUTH_SECRET oder BOOKING_TOKEN_SECRET (separater Blast-Radius).
# Generieren: `openssl rand -base64 32` (≥ 32 Zeichen empfohlen, min 16).
# Token-Format: `base64url(customerId + ':' + hmac.slice(0, 32))`.
# Wenn die Variable rotiert wird, werden ALLE bisherigen Unsubscribe-Links
# in alten Marketing-Mails ungültig — eine bewusste, sichere Wahl.
UNSUBSCRIBE_TOKEN_SECRET=""
