# Database
# Lokal:    relativ zur prisma/schema.prisma → Datei landet in prisma/dev.db
# Turso:    libsql://<db-name>-<org>.turso.io?authToken=<token>
DATABASE_URL="file:./dev.db"
DIRECT_DATABASE_URL="file:./dev.db"

# NextAuth — Pflicht
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-32-plus-character-random-string"
# AUTH_SECRET ist Alias für NEXTAUTH_SECRET (NextAuth v5)
AUTH_SECRET="change-me-to-a-32-plus-character-random-string"
AUTH_TRUST_HOST="true"

# Resend / Mail — Pflicht
# Mit dem Placeholder `re_xxxxxxxxxxxx` schlägt der Mail-Versand stillschweigend
# fehl, Buchungen werden trotzdem persistiert (mailSent=false im Admin sichtbar).
# Echten Wert in resend.com → API Keys generieren.
RESEND_API_KEY="re_xxxxxxxxxxxx"
# Free-Tier-Hinweis: Ohne DNS-verifizierte Domain darf Resend nur an die
# Resend-Account-E-Mail senden. Für Iteration 2 (Mails an beliebige Kunden)
# wird eine verifizierte Absender-Domain Pflicht.
MAIL_FROM="onboarding@resend.dev"
MAIL_TO_ADMIN="hausservice-baerenstark@outlook.com"

# Iteration 2: Public Base-URL für Aktionslinks in Mails (Counter-Proposal,
# Storno). Fallback ist NEXTAUTH_URL.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Upstash Redis (optional; ohne diese Werte ist Rate-Limit deaktiviert)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Iteration 3 / US-18 — Vercel Blob für Datei-Uploads.
# Token aus Vercel Dashboard → Storage → Blob → Connect to Project.
# Ohne diesen Token schlägt POST /api/upload mit 502 + klarer Fehlermeldung fehl
# (Buchungen ohne Anhänge funktionieren weiterhin).
BLOB_READ_WRITE_TOKEN=""

# Iteration 4 / US-28 — Stripe-Zahlungen.
# Test-Mode: sk_test_... + pk_test_... + whsec_... aus Stripe Dashboard.
# Live-Mode: sk_live_... + pk_live_... + whsec_... (frischer Webhook-Secret).
# Ohne Konfiguration meldet POST /api/admin/bookings/:id/payment den Code
# `STRIPE_NOT_CONFIGURED` zurück; das Backend bleibt bedienbar, aber Stripe-
# Checkout-Sessions können nicht erstellt werden.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
