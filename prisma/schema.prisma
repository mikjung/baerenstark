// Bärenstark Hausservice — Live Prisma Schema (v1.6.1 — Iteration 6, QA-Revision)
// Synchron gehalten mit /contracts/schema.prisma.
//
// Iteration 6 Änderungen (US-IT6-01 bis US-IT6-09):
//   - US-IT6-01 (Multi-Admin): User.status (UserStatus enum), createdById, lastLoginAt.
//   - US-IT6-03 (Reviews): Review.rejectedAt, moderatedAt, moderatedById +
//     neuer Index [approved, rejectedAt, createdAt].
//   - US-IT6-07 (Admin-Userverwaltung): CustomerUser.adminNote, adminRating.
//   - US-IT6-08 (Finaler Preis): Booking.finalPriceEur (Decimal),
//     Booking.finalPriceNote.
//   - Querschnitts-Indexe: users(status), customer_users(lastName, firstName),
//     bookings(status, date), bookings(customerId, status).
//
// Iteration 5 Änderungen:
//   - US-31 (OAuth2): CustomerUser.oauthProvider/oauthId/avatarUrl neu;
//     passwordHash wird nullable (OAuth-only-Konten ohne lokales Passwort).
//   - US-32 (Adresse): Booking.addressStreet/addressZip/addressCity neu
//     (DB-nullable für Bestand, API-Pflicht ab IT5).
//   - US-33 (Dauer): Booking.durationMinutes Int @default(60) neu.
//   - US-34 (Buffer): NEUE Tabelle BufferConfig (Singleton, Default 30 min).
//
// Iteration 4 Änderungen:
//   - NEU: CustomerUser (US-25) — separate Kunden-Auth-Entität.
//   - NEU: Payment (US-28) — Stripe-Zahlung 1:1 zu Booking.
//   - NEU: Review (US-29) — Kundenbewertung mit Admin-Freigabe.
//   - Booking.customerId? (FK → CustomerUser, ON DELETE SET NULL).
//   - Booking.status erlaubt zusätzlich 'COMPLETED'.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Admin-Benutzer (NextAuth Credentials Provider).
///
/// Iteration 6 (US-IT6-01) ergänzt:
///   - status: 'ACTIVE' | 'DISABLED' (TEXT — SQLite kennt keine ENUMs).
///     Validierung im App-Layer via Zod `UserStatusSchema`. Lock-out-Schutz
///     in `src/lib/admin-status.ts.disableAdminSafely`.
///   - createdById: Self-FK auf den anlegenden Admin (NULL für Bootstrap).
///   - lastLoginAt: wird im NextAuth-`jwt`-Callback aktualisiert.
model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  name             String
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  // IT6 / US-IT6-01: 'ACTIVE' | 'DISABLED'.
  status           String    @default("ACTIVE")
  createdById      String?
  createdBy        User?     @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAdmins    User[]    @relation("UserCreatedBy")
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  // IT6 / US-IT6-03 — moderierte Reviews:
  moderatedReviews Review[] @relation("ReviewModeratedBy")

  // IT12 / US-IT12-15 — gesendete Marketing-Mails (Audit).
  marketingEmailsSent MarketingEmail[] @relation("MarketingEmailSentBy")

  @@index([status])
  @@map("users")
}

/// Kunden-Account (Iteration 4 / US-25, Iteration 5 / US-31, Iteration 7 / US-IT7-01+05).
/// Vollständig getrennt vom Admin-`User`-Modell.
///
/// IT5 / US-31: passwordHash nullable; oauthProvider/oauthId/avatarUrl neu.
/// IT7 / US-IT7-01: emailVerifiedAt neu (Audit-Timestamp).
/// IT7 / US-IT7-05: resetToken/resetTokenExpiry entfernt — Reset-Logik
///                  in eigene Tabelle `PasswordResetToken` (siehe unten).
model CustomerUser {
  id                      String    @id @default(cuid())
  email                   String    @unique
  /// IT5 nullable: OAuth-only-Konten haben kein lokales Passwort.
  passwordHash            String?
  firstName               String
  lastName                String
  phone                   String?
  /// IT5: OAuth-Konten erhalten direkt `emailVerified = true` (Provider-Trust).
  /// IT7 / US-IT7-01: emailVerified ist KEIN harter Login-Block —
  /// Customer-Login funktioniert auch mit `emailVerified=false`,
  /// Frontend zeigt einen Banner.
  emailVerified           Boolean   @default(false)
  /// IT7 / US-IT7-01: Audit-Timestamp wann die Verifizierung gesetzt wurde.
  /// NULL solange `emailVerified=false`. Datenbasis für künftige Re-Verify-
  /// Mechanik.
  emailVerifiedAt         DateTime?
  verificationToken       String?   @unique
  /// 24h-Ablauf (BUG-401-Fix v1.4.1) — wird bei Resend mit-aktualisiert.
  verificationTokenExpiry DateTime?

  /// IT5 / US-31 — OAuth2-Verknüpfung. Null = reines E-Mail/Passwort-Konto.
  oauthProvider String?
  oauthId       String?
  avatarUrl     String?

  // IT6 / US-IT6-07 — Admin-Userverwaltung (INTERN, NIE customer-facing).
  /// Interner Freitext (App-Layer max 1000 Zeichen). NIEMALS in
  /// `/api/customer/*`-Responses. Schutz via DTO-Helper
  /// `selectCustomerUserPublic()` (siehe `src/lib/dto/user.ts`).
  adminNote   String?
  /// Interne Sterne-Bewertung 1..5 (App-Layer). NIEMALS customer-facing.
  /// Hat nichts mit öffentlichen Reviews zu tun.
  adminRating Int?

  // IT9 / US-IT9-02 — Default-Adresse des Kunden (Profil).
  /// Alle drei Felder optional → niemand wird beim Onboarding blockiert.
  /// Pflicht-Validierung greift im Booking-POST (siehe ARCHITECTURE_IT9.md §2.5).
  /// App-Layer-Validierung über `ZipCodeSchema` (`/^\d{5}$/`, DE).
  /// Bewusst NICHT die `addressStreet/addressZip/addressCity`-Naming-Convention
  /// der Booking-Adresse recyceln — die Buchungs-Adresse ist semantisch der
  /// Wahrheits-Anker pro Auftrag, die Profil-Adresse ist der Default.
  /// Straße + Hausnummer (App-Layer 3..100 chars).
  streetAndNumber String?
  /// 5-stellige deutsche PLZ (App-Layer Regex).
  postalCode      String?
  /// Ort (App-Layer 2..100 chars).
  city            String?

  // IT12 / US-IT12-15 — Marketing-Mail-Opt-Out (DSGVO Variante 3 / UWG §7 Abs. 3).
  /// Zeitpunkt, an dem der Kunde sich von Marketing-Mails abgemeldet hat.
  /// NULL = aktiv (Default — Bestandskunden-Sonderregel). Wenn gesetzt, werden
  /// alle künftigen Marketing-Bulk-Sends an diesen Customer hart aussortiert.
  /// Transaktionale Mails (Bestätigung, Storno, Reset) sind NICHT betroffen.
  unsubscribedAt     DateTime?
  /// Optionaler Grund — z.B. 'EMAIL_FOOTER' (Klick auf Unsubscribe-Link in
  /// einer Marketing-Mail) oder 'ADMIN' (manuelle Markierung durch Tom).
  unsubscribedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings                 Booking[]
  reviews                  Review[]
  /// IT7 / US-IT7-05 — Backref auf Reset-Token-Records.
  passwordResetTokens      PasswordResetToken[]
  /// IT12 / US-IT12-15 — Backref auf Marketing-Mail-Empfänger-Records.
  marketingEmailRecipients MarketingEmailRecipient[]

  @@index([email])
  @@index([oauthProvider, oauthId])
  // IT6 / US-IT6-07 — Sortierung im /admin/users Listing.
  @@index([lastName, firstName])
  // IT6 / US-IT6-07 — Sort-Whitelist `adminRating_desc`.
  @@index([adminRating])
  // IT12 / US-IT12-15 — Sparse-Index für Marketing-Filter (Default unsubscribed=null).
  @@index([unsubscribedAt])
  @@map("customer_users")
}

/// IT7 / US-IT7-05 — Passwort-Reset-Tokens (Kunden).
///
/// Sicherheits-Design:
///   - `tokenHash` ist der **SHA-256-Hex-Digest** (64 Zeichen) des
///     Klartext-Tokens. Klartext wird NIEMALS in der DB gespeichert.
///   - `expiresAt` = `createdAt + 1h`.
///   - `usedAt` IS NULL → ungenutzt; gesetzt → verbraucht (single-use).
///   - ON DELETE CASCADE auf customerId — Wipe (US-IT6-06) räumt automatisch ab.
///
/// Atomarer Token-Verbrauch in `/api/customer/reset-password` via
/// Conditional UPDATE (m2-IT7) — siehe ARCHITECTURE_IT7.md §5.3.
model PasswordResetToken {
  id         String       @id @default(cuid())
  customerId String
  customer   CustomerUser @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// SHA-256 hex digest, 64 chars.
  tokenHash  String       @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime     @default(now())

  @@index([customerId, expiresAt])
  @@map("password_reset_tokens")
}

model Slot {
  id          String    @id @default(cuid())
  startsAt    DateTime
  endsAt      DateTime
  description String?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  bookings                Booking[] @relation("BookingPrimarySlot")
  counterProposalBookings Booking[] @relation("BookingCounterProposalSlot")

  @@index([startsAt])
  @@index([startsAt, endsAt])
  @@index([deletedAt])
  @@map("slots")
}

/// SQLite kennt kein natives ENUM. Status wird als TEXT abgelegt; gültige Werte
/// werden im API-Layer durch Zod (BookingStatusSchema) erzwungen.
/// Werte (IT4): 'PENDING' | 'CONFIRMED' | 'REJECTED' | 'COUNTER_PROPOSED' | 'CANCELLED' | 'COMPLETED'.
model Booking {
  id String @id @default(cuid())

  // Iteration 1/2: Slot-basiert (DEPRECATED, nur Bestand). Optional ab IT3.
  slotId String?
  slot   Slot?   @relation("BookingPrimarySlot", fields: [slotId], references: [id], onDelete: Restrict)

  // Iteration 3 (US-17): Date/Time-basierte Buchung.
  date      String?
  startTime String?
  endTime   String?

  // Iteration 5 (US-33): vom Kunden gewählte Auftragsdauer in Minuten.
  // endTime = startTime + durationMinutes (App-Layer berechnet/validiert).
  durationMinutes Int @default(60)

  // Iteration 4 (US-25/26): optionale Verknüpfung mit Kundenkonto.
  customerId String?
  customer   CustomerUser? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  customerName  String
  customerPhone String
  customerEmail String?
  service       String
  description   String

  // Iteration 5 (US-32): Adresse des Auftragsorts.
  // DB-nullable für Bestand, API-Pflicht für neue Buchungen.
  addressStreet String?
  addressZip    String?
  addressCity   String?

  status String @default("PENDING")

  mailSent  Boolean @default(false)
  mailError String?

  // Iteration 2 Felder
  cancelToken           String  @unique @default(cuid())
  counterProposalSlotId String?
  counterProposalSlot   Slot?   @relation("BookingCounterProposalSlot", fields: [counterProposalSlotId], references: [id], onDelete: SetNull)

  // Iteration 3: Datei-Anhänge.
  attachments BookingAttachment[]

  // Iteration 4 Backrefs.
  payment Payment?
  review  Review?

  // IT6 / US-IT6-08 — Finaler Preis pro Buchung (intern).
  /// Vom Admin in der Detail-Ansicht eingetragener Endbetrag in Euro.
  /// Range im App-Layer: 0..100000. NIEMALS customer-facing
  /// (`CustomerBookingSchema.strict()` filtert das Feld aus). Datenbasis
  /// für US-IT6-09 (Analytics).
  finalPriceEur  Decimal?
  /// Optionale Notiz zum Preis (z.B. "inkl. Anfahrt"). Max 200 Zeichen
  /// (App-Layer). NIEMALS customer-facing.
  finalPriceNote String?

  // IT14 / US-IT14-S05 — Zahlungsart (intern, von Tom erfasst).
  /// Werte: 'CASH' | 'BANK_TRANSFER'. NULL = nicht erfasst (Default).
  /// SQLite hat kein ENUM — App-Layer validiert via Zod
  /// (PaymentMethodSchema in contracts/zod-schemas.ts). Migration:
  /// prisma/migrations/20260504130000_iteration_14_payment_method.
  /// Customer-facing NIE — internes Admin-Feld, keine UI im
  /// Buchungsformular.
  paymentMethod  String?

  // IT11 / US-IT11-06 — Audit-Trail für Stornierungen.
  /// Zeitpunkt der Stornierung (UTC). NULL solange nicht storniert.
  cancelledAt        DateTime?
  /// Initiator: 'CUSTOMER' (eingeloggt oder via Gast-Token), 'ADMIN' (Tom),
  /// 'SYSTEM' (zukünftig: Auto-Cleanup). App-Layer-Validation via Zod.
  cancelledBy        String?
  /// Optionaler Freitext (max 500 chars, App-Layer). Customer kann optional
  /// einen Grund eintragen.
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slotId])
  @@index([status, createdAt])
  @@index([counterProposalSlotId])
  @@index([date, status])
  @@index([status, date, startTime])
  @@index([customerId, date])
  // IT6 / US-IT6-09 — Top-Kunden-Aggregation (groupBy customerId, status).
  @@index([customerId, status])
  @@map("bookings")
}

/// Default-Vorlage pro Wochentag (Iteration 3 / US-17).
/// Genau 7 Datensätze (dayOfWeek 0–6).
model AvailabilityTemplate {
  id                  String   @id @default(cuid())
  dayOfWeek           Int      @unique
  isActive            Boolean  @default(false)
  startTime           String   @default("08:00")
  endTime             String   @default("17:00")
  slotDurationMinutes Int      @default(60)
  updatedAt           DateTime @updatedAt

  @@index([dayOfWeek])
  @@map("availability_template")
}

/// Individuelle Tages-Überschreibung (Iteration 3 / US-17).
model DayOverride {
  id        String   @id @default(cuid())
  date      String   @unique
  isActive  Boolean
  startTime String?
  endTime   String?
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@map("day_overrides")
}

/// Datei-Anhang an einer Buchung (Iteration 3 / US-18).
model BookingAttachment {
  id          String   @id @default(cuid())
  bookingId   String?
  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  url         String
  filename    String
  contentType String
  sizeBytes   Int
  createdAt   DateTime @default(now())

  @@index([bookingId])
  @@map("booking_attachments")
}

/// Wochentag-basierte Verfügbarkeit (Iteration 2 / US-15).
/// DEPRECATED ab Iteration 3 zugunsten von AvailabilityTemplate.
model WeeklyAvailability {
  id        String   @id @default(cuid())
  dayOfWeek Int      @unique
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dayOfWeek])
  @@map("weekly_availability")
}

/// Stripe-Zahlung für eine Buchung (Iteration 4 / US-28).
/// 1:1 zu Booking. Tom legt sie an via POST /api/admin/bookings/:id/payment.
model Payment {
  id              String    @id @default(cuid())
  bookingId       String    @unique
  booking         Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  stripeSessionId String?   @unique
  amount          Int
  currency        String    @default("eur")
  description     String?
  status          String    @default("PENDING")
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([stripeSessionId])
  @@map("payments")
}

/// Kundenbewertung (Iteration 4 / US-29, IT6 / US-IT6-03).
/// 1:1 zu Booking, optional zu CustomerUser.
///
/// IT6-Erweiterung (US-IT6-03):
///   - rejectedAt: timestamp des letzten Rejects (NULL bei APPROVED).
///     Abgeleiteter Status:
///       (approved=false, rejectedAt=null)  → PENDING_APPROVAL
///       (approved=true,  rejectedAt=null)  → APPROVED
///       (approved=false, rejectedAt!=null) → REJECTED
///   - moderatedAt + moderatedById: Audit-Spur, wird bei Approve/Reject
///     im PATCH /api/admin/reviews/:id gesetzt.
model Review {
  id            String        @id @default(cuid())
  customerId    String?
  customer      CustomerUser? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  bookingId     String?       @unique
  booking       Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  stars         Int
  text          String?
  approved      Boolean       @default(false)
  // IT6 / US-IT6-03:
  rejectedAt    DateTime?
  moderatedById String?
  moderatedBy   User?         @relation("ReviewModeratedBy", fields: [moderatedById], references: [id], onDelete: SetNull)
  moderatedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([approved, createdAt])
  // IT6 / US-IT6-03 — Moderation-Queue + Public-Filter.
  @@index([approved, rejectedAt, createdAt])
  @@index([customerId])
  @@map("reviews")
}

/// Globale Buffer-Konfiguration (Iteration 5 / US-34).
/// Singleton — genau ein Datensatz. Default 30 Minuten.
/// App-Layer validiert auf Whitelist [0, 15, 30, 45, 60].
model BufferConfig {
  id            String   @id @default(cuid())
  bufferMinutes Int      @default(30)
  updatedAt     DateTime @updatedAt

  @@map("buffer_config")
}

/// IT12 / US-IT12-15 — Marketing-E-Mail Audit.
///
/// Dokumentiert, welcher Admin wann an wie viele Empfänger welche Mail
/// gesendet hat. Werte (status):
///   'draft'           — Mail im Composer angelegt, noch nicht versendet.
///   'queued'          — Send-Trigger empfangen, Recipient-Set wird vorbereitet.
///   'sending'         — Resend-Calls laufen.
///   'sent'            — alle Empfänger erfolgreich versorgt.
///   'partial_failure' — mind. 1 FAILED, mind. 1 SUCCESS.
///   'failed'          — 0 SUCCESS (z.B. Resend-Outage).
///
/// Hard-Cap pro Send (IT12): 50 Empfänger (Vercel-Hobby-Timeout).
/// Daily-Cap (IT12): 100/Tag (Resend Free).
model MarketingEmail {
  id             String    @id @default(cuid())
  /// FK auf den absendenden Admin (NextAuth `User`). RESTRICT, damit der
  /// Audit-Pfad nicht durch Admin-Löschung gebrochen wird.
  sentByAdminId  String
  sentByAdmin    User      @relation("MarketingEmailSentBy", fields: [sentByAdminId], references: [id], onDelete: Restrict)
  /// Betreff (App-Layer 1..200 chars).
  subject        String
  /// Plain-Text-Body, von Tom verfasst (App-Layer 1..5000 chars). DSGVO-Footer
  /// hängt der Server beim Senden automatisch dran (siehe `lib/marketing-mail.ts`).
  bodyText       String
  /// JSON-Array der Service-Slugs, die beim Empfänger-Filter aktiv waren —
  /// reines Audit-Field, nicht ausgewertet beim Send.
  filterServices String
  /// Anzahl der Empfänger, an die TATSÄCHLICH gesendet wurde
  /// (nach Unsubscribe-Filter).
  recipientCount Int
  /// Erfolgreiche Sends.
  successCount   Int       @default(0)
  /// Fehlgeschlagene Sends.
  failureCount   Int       @default(0)
  /// 'draft' | 'queued' | 'sending' | 'sent' | 'partial_failure' | 'failed'.
  status         String    @default("draft")
  createdAt      DateTime  @default(now())
  /// Wenn alle Sends abgeschlossen sind.
  completedAt    DateTime?

  recipients MarketingEmailRecipient[]

  @@index([sentByAdminId, createdAt])
  @@index([status, createdAt])
  @@map("marketing_emails")
}

/// IT12 / US-IT12-15 — Pro Empfänger ein Record (Audit + Status).
///
/// Werte (status): 'PENDING' | 'SENT' | 'FAILED'.
/// Email ist Snapshot zum Sendezeitpunkt (auch wenn Customer später die
/// E-Mail-Adresse ändert, bleibt der Audit-Eintrag korrekt).
model MarketingEmailRecipient {
  id               String         @id @default(cuid())
  marketingEmailId String
  marketingEmail   MarketingEmail @relation(fields: [marketingEmailId], references: [id], onDelete: Cascade)
  customerId       String
  customer         CustomerUser   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// Snapshot der E-Mail zum Sendezeitpunkt.
  email            String
  /// 'PENDING' | 'SENT' | 'FAILED'.
  status           String         @default("PENDING")
  /// Resend-Response-Message-ID (für späteres Bounce-Tracing).
  resendMessageId  String?
  /// Bei status='FAILED': die Fehlermeldung von Resend.
  errorMessage     String?
  sentAt           DateTime?
  createdAt        DateTime       @default(now())

  @@index([marketingEmailId, status])
  @@index([customerId])
  @@index([sentAt])
  @@map("marketing_email_recipients")
}

/// IT12 / US-IT12-11 — Idempotency-Key-Cache für POST /api/bookings.
///
/// Bei doppeltem Submit mit gleichem Header `Idempotency-Key`:
/// cached Response zurück, kein neuer Insert. TTL 24h.
model IdempotencyKey {
  id        String   @id @default(cuid())
  /// Vom Frontend pro Submit generiert (UUID).
  key       String   @unique
  /// Optionaler Email-Bind (verhindert Cross-User-Re-Use).
  scope     String?
  /// JSON-stringified Response.
  response  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("idempotency_keys")
}
