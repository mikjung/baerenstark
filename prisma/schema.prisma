// Bärenstark Hausservice — Live Prisma Schema (v1.5 — Iteration 5)
// Synchron gehalten mit /contracts/schema.prisma.
//
// Iteration 5 Änderungen:
//   - US-31 (OAuth2): CustomerUser.oauthProvider/oauthId/avatarUrl neu;
//     passwordHash wird nullable (OAuth-only-Konten ohne lokales Passwort).
//   - US-32 (Adresse): Booking.addressStreet/addressZip/addressCity neu
//     (DB-nullable für Bestand, API-Pflicht ab IT5).
//   - US-33 (Dauer): Booking.durationMinutes Int @default(60) neu.
//   - US-34 (Buffer): NEUE Tabelle BufferConfig (Singleton, Default 30 min).
//
// Iteration 4 Änderungen:
//   - NEU: CustomerUser (US-25) — separate Kunden-Auth-Entität.
//   - NEU: Payment (US-28) — Stripe-Zahlung 1:1 zu Booking.
//   - NEU: Review (US-29) — Kundenbewertung mit Admin-Freigabe.
//   - Booking.customerId? (FK → CustomerUser, ON DELETE SET NULL).
//   - Booking.status erlaubt zusätzlich 'COMPLETED'.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  name             String
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())

  @@map("users")
}

/// Kunden-Account (Iteration 4 / US-25, Iteration 5 / US-31).
/// Vollständig getrennt vom Admin-`User`-Modell.
///
/// IT5 / US-31: passwordHash nullable; oauthProvider/oauthId/avatarUrl neu.
model CustomerUser {
  id                      String    @id @default(cuid())
  email                   String    @unique
  /// IT5 nullable: OAuth-only-Konten haben kein lokales Passwort.
  passwordHash            String?
  firstName               String
  lastName                String
  phone                   String?
  /// IT5: OAuth-Konten erhalten direkt `emailVerified = true` (Provider-Trust).
  emailVerified           Boolean   @default(false)
  verificationToken       String?   @unique
  /// 24h-Ablauf (BUG-401-Fix v1.4.1) — wird bei Resend mit-aktualisiert.
  verificationTokenExpiry DateTime?
  resetToken              String?   @unique
  resetTokenExpiry        DateTime?

  /// IT5 / US-31 — OAuth2-Verknüpfung. Null = reines E-Mail/Passwort-Konto.
  oauthProvider String?
  oauthId       String?
  avatarUrl     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]
  reviews  Review[]

  @@index([email])
  @@index([oauthProvider, oauthId])
  @@map("customer_users")
}

model Slot {
  id          String    @id @default(cuid())
  startsAt    DateTime
  endsAt      DateTime
  description String?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  bookings                Booking[] @relation("BookingPrimarySlot")
  counterProposalBookings Booking[] @relation("BookingCounterProposalSlot")

  @@index([startsAt])
  @@index([startsAt, endsAt])
  @@index([deletedAt])
  @@map("slots")
}

/// SQLite kennt kein natives ENUM. Status wird als TEXT abgelegt; gültige Werte
/// werden im API-Layer durch Zod (BookingStatusSchema) erzwungen.
/// Werte (IT4): 'PENDING' | 'CONFIRMED' | 'REJECTED' | 'COUNTER_PROPOSED' | 'CANCELLED' | 'COMPLETED'.
model Booking {
  id String @id @default(cuid())

  // Iteration 1/2: Slot-basiert (DEPRECATED, nur Bestand). Optional ab IT3.
  slotId String?
  slot   Slot?   @relation("BookingPrimarySlot", fields: [slotId], references: [id], onDelete: Restrict)

  // Iteration 3 (US-17): Date/Time-basierte Buchung.
  date      String?
  startTime String?
  endTime   String?

  // Iteration 5 (US-33): vom Kunden gewählte Auftragsdauer in Minuten.
  // endTime = startTime + durationMinutes (App-Layer berechnet/validiert).
  durationMinutes Int @default(60)

  // Iteration 4 (US-25/26): optionale Verknüpfung mit Kundenkonto.
  customerId String?
  customer   CustomerUser? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  customerName  String
  customerPhone String
  customerEmail String?
  service       String
  description   String

  // Iteration 5 (US-32): Adresse des Auftragsorts.
  // DB-nullable für Bestand, API-Pflicht für neue Buchungen.
  addressStreet String?
  addressZip    String?
  addressCity   String?

  status String @default("PENDING")

  mailSent  Boolean @default(false)
  mailError String?

  // Iteration 2 Felder
  cancelToken           String  @unique @default(cuid())
  counterProposalSlotId String?
  counterProposalSlot   Slot?   @relation("BookingCounterProposalSlot", fields: [counterProposalSlotId], references: [id], onDelete: SetNull)

  // Iteration 3: Datei-Anhänge.
  attachments BookingAttachment[]

  // Iteration 4 Backrefs.
  payment Payment?
  review  Review?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slotId])
  @@index([status, createdAt])
  @@index([counterProposalSlotId])
  @@index([date, status])
  @@index([status, date, startTime])
  @@index([customerId, date])
  @@map("bookings")
}

/// Default-Vorlage pro Wochentag (Iteration 3 / US-17).
/// Genau 7 Datensätze (dayOfWeek 0–6).
model AvailabilityTemplate {
  id                  String   @id @default(cuid())
  dayOfWeek           Int      @unique
  isActive            Boolean  @default(false)
  startTime           String   @default("08:00")
  endTime             String   @default("17:00")
  slotDurationMinutes Int      @default(60)
  updatedAt           DateTime @updatedAt

  @@index([dayOfWeek])
  @@map("availability_template")
}

/// Individuelle Tages-Überschreibung (Iteration 3 / US-17).
model DayOverride {
  id        String   @id @default(cuid())
  date      String   @unique
  isActive  Boolean
  startTime String?
  endTime   String?
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@map("day_overrides")
}

/// Datei-Anhang an einer Buchung (Iteration 3 / US-18).
model BookingAttachment {
  id          String   @id @default(cuid())
  bookingId   String?
  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  url         String
  filename    String
  contentType String
  sizeBytes   Int
  createdAt   DateTime @default(now())

  @@index([bookingId])
  @@map("booking_attachments")
}

/// Wochentag-basierte Verfügbarkeit (Iteration 2 / US-15).
/// DEPRECATED ab Iteration 3 zugunsten von AvailabilityTemplate.
model WeeklyAvailability {
  id        String   @id @default(cuid())
  dayOfWeek Int      @unique
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dayOfWeek])
  @@map("weekly_availability")
}

/// Stripe-Zahlung für eine Buchung (Iteration 4 / US-28).
/// 1:1 zu Booking. Tom legt sie an via POST /api/admin/bookings/:id/payment.
model Payment {
  id              String    @id @default(cuid())
  bookingId       String    @unique
  booking         Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  stripeSessionId String?   @unique
  amount          Int
  currency        String    @default("eur")
  description     String?
  status          String    @default("PENDING")
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([stripeSessionId])
  @@map("payments")
}

/// Kundenbewertung (Iteration 4 / US-29).
/// 1:1 zu Booking, optional zu CustomerUser.
model Review {
  id         String        @id @default(cuid())
  customerId String?
  customer   CustomerUser? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  bookingId  String?       @unique
  booking    Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  stars      Int
  text       String?
  approved   Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([approved, createdAt])
  @@index([customerId])
  @@map("reviews")
}

/// Globale Buffer-Konfiguration (Iteration 5 / US-34).
/// Singleton — genau ein Datensatz. Default 30 Minuten.
/// App-Layer validiert auf Whitelist [0, 15, 30, 45, 60].
model BufferConfig {
  id            String   @id @default(cuid())
  bufferMinutes Int      @default(30)
  updatedAt     DateTime @updatedAt

  @@map("buffer_config")
}
